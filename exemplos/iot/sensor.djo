// Lê um sensor ligado na serial (Arduino, ESP32...), guarda num arquivo e envia para um servidor.
// O sensor manda uma linha por leitura, como: 23.5
//
// Rode:  djo sensor.djo
var porta = Serial.open:"/dev/ttyUSB0":9600
var lidas = 0

until{
    eng[i = 0 ; lidas == 10 ; i++]
    var linha = Serial.readline:porta:5000
    if
        cond[linha == nil]
        print "sem resposta do sensor"
    else
        var temp = float:linha
        if
            cond[temp != nil]
            var agora = Time.now:
            File.append:"leituras.csv":(str:agora) + "," + linha + "\n"
            var r = Http.post:"http://192.168.0.10:8080/leituras":{"sensor": "sala", "temp": temp, "hora": agora}
            if
                cond[not r["ok"]]
                print "não enviou: " + (r["error"] ?? str:r["status"])
            lidas++
    Time.sleep:1000
}

Serial.close:porta
