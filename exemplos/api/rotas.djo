// Uma API de tarefas: leituras (GET) e escritas (POST, PUT, PATCH, DELETE) com token.
// Só as rotas daqui existem. O resto da pasta é código interno.
Route.site:{"nome": "API de tarefas", "about": "Cria, lista, troca, marca e apaga tarefas. Todas as chamadas pedem Authorization: Bearer SEU_TOKEN."}

// Um front-end em outro endereço só consegue chamar a API se a origem dele estiver aqui.
Route.cors:{"origins": ["http://localhost:5173"], "headers": ["Content-Type", "Authorization"]}

Route.get:"/tarefas":{"agent": "agentes/tarefas.djo", "about": "Lista as tarefas", "returns": ["Tarefa"]}
Route.get:"/tarefas/{id}":{"agent": "agentes/tarefa.djo", "returns": "Tarefa"}

Route.action:"/tarefas":"criar_tarefa":"Tarefa"
Route.put_action:"/tarefas/{id}":"trocar_tarefa":"Tarefa"
Route.patch_action:"/tarefas/{id}/feita":"marcar_feita":"Tarefa"
Route.delete_action:"/tarefas/{id}":"apagar_tarefa"
