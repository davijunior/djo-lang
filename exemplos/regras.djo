// regras iniciais
print 2 + 2        // 4
print 2 + "2"      // 4
print "2" + "2"    // 22

// monta a palavra letra por letra
var palavra = ""
while{
    cond[
        palavra != "texto"
    ]
    params[
        var i = 0
        arr text = ["t","e","x","t","o"]
    ]

    palavra = palavra + text[i]

    print palavra

    i++
}

// repete até i == 4
until{
    eng[i=0 ; i == 4; i++]
    print i
}
